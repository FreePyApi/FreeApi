PREFERED_TIME_SERVER=your_preferred_time_server_here
ENV=development
REDIS_URL=redis://localhost:6379/0
POSTGRES_URL=postgresql://freeapi:freeapi@localhost:5432/freeapi
API_KEY_PEPPER=replace_with_a_long_random_secret

# Optional OAuth2 login. When both are set, cookie-based auth is enabled.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Optional overrides for a non-GitHub OAuth provider.
# OAUTH_AUTHORIZE_URL=
# OAUTH_TOKEN_URL=
# OAUTH_USERINFO_URL=
# OAUTH_REDIRECT_URI=
# OAUTH_SCOPES=

# Optional cookie secret. If omitted, the app falls back to OAUTH_CLIENT_SECRET.
# SESSION_SECRET=